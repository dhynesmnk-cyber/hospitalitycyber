---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import Tldr from '../components/Tldr.astro';
import Stamp from '../components/Stamp.astro';
import { site } from '../config/site';
import { isoDate, longDate } from '../lib/format';

type Source = CollectionEntry<'writing'>['data']['sources'][number];

interface Props {
  kind: 'writing' | 'chapter';
  title: string;
  description: string;
  standfirst?: string;
  tldr?: string[];
  noindex?: boolean;
  label: string;
  labelHref: string;
  chapterNo?: string;
  stampWord: string;
  stampDate: Date;
  tocLabel: string;
  headings: { slug: string; text: string; depth: number }[];
  sources: Source[];
  badge?: string;
  readMinutes?: number;
}

const {
  kind,
  title,
  description,
  standfirst = description,
  tldr = [],
  noindex = false,
  label,
  labelHref,
  chapterNo,
  stampWord,
  stampDate,
  tocLabel,
  headings,
  sources,
  badge,
  readMinutes,
} = Astro.props;

const tocItems = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })),
  { slug: 'sources', text: 'Sources' },
];
---

<Base title={title} description={description} noindex={noindex} current={kind === 'writing' ? 'writing' : 'chapters'}>
  <article class={`piece ${kind}`}>
    <header class="piece-head">
      <div class="wrap">
        <p class="label"><a href={labelHref}>{label}</a></p>
        {
          chapterNo && (
            <p class="chapter-no">
              <span class="chapter-word">Chapter</span> <span class="chapter-num">{chapterNo}</span>
            </p>
          )
        }
        <div class="head-main">
          <h1>{title}</h1>
          <p class="standfirst">{standfirst}</p>
          {tldr.length > 0 && <Tldr items={tldr} />}
        </div>
        <div class="meta">
          <p class="by">By {site.author}</p>
          <Stamp word={stampWord} date={stampDate} />
          {readMinutes && <p class="read-time">{readMinutes} min read</p>}
          {badge && <p class="stamp">{badge}</p>}
        </div>
      </div>
    </header>
    {
      tldr.length > 0 && (
        <div class="wrap head-rule-wrap">
          <hr class="head-rule" />
        </div>
      )
    }

    <div class="piece-body">
      <div class="wrap">
        <Toc label={tocLabel} items={tocItems} />
        <div class="prose">
          <div class="md"><slot /></div>

          <section class="sources" aria-labelledby="sources">
            <h2 id="sources">Sources</h2>
            {kind === 'writing' && sources.length > 0 && (
              <p class="sources-note">
                Every quotation in this piece is word for word from these pages. Each entry shows the date it was read.
              </p>
            )}
            {
              sources.length === 0 ? (
                <p class="placeholder">No sources are listed for this page yet.</p>
              ) : (
                <ol class="source-list" role="list">
                  {sources.map((s, i) => (
                    <li id={`src-${i + 1}`}>
                      {s.publisher}, <cite><a href={s.url} rel="noopener">{s.title}</a></cite>
                      {s.section ? `, ${s.section}` : ''}. {s.dated}. Read{' '}
                      <time datetime={isoDate(s.accessed)}>{longDate(s.accessed)}</time>.
                    </li>
                  ))}
                </ol>
              )
            }
          </section>

          <slot name="end" />
        </div>
      </div>
    </div>
  </article>

  <div class="wrap bands after">
    <slot name="after" />
  </div>
</Base>
