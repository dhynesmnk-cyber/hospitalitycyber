---
import { site } from '../config/site';

interface Props {
  id: string;
  line?: string;
}

const { id, line = site.signupLine } = Astro.props;
// Until the publication exists there is no form to fill in: a box you cannot type in is worse than a plain sentence.
const live = site.newsletter.formUrl !== '';
---

<div class="band-main signup-box">
  <p class="signup-line">{line}</p>
  {
    live ? (
      <form class="signup" action={site.newsletter.formUrl} method="post" target="_blank">
        <label for={id}>Email address</label>
        <div class="signup-row">
          <input id={id} name="email" type="email" autocomplete="email" required />
          <button type="submit">Subscribe, free</button>
        </div>
      </form>
    ) : (
      <p class="signup-status">
        Email signup is not open yet. Until it is, every piece is here: the <a href="/writing/">writing</a> and the{' '}
        <a href="/chapters/">Hospitality Tools Resource</a>.
      </p>
    )
  }
</div>
