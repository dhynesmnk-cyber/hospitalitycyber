---
// The TL;DR at the head of an article, in plain language. The first item is the key takeaway:
// what the author thinks the evidence means. It starts "My read:", and the tag is shown as a
// label. The rest are the plain facts behind it. `summary` shows the takeaway alone, for lists.
// `rule` puts a rule above it (used on the article page). Elsewhere it stands bare.
interface Props {
  items: string[];
  summary?: boolean;
  rule?: boolean;
}

const { items, summary = false, rule = false } = Astro.props;
const [first = '', ...rest] = items;
const tagged = first.startsWith('My read:');
const rawTake = tagged ? first.slice('My read:'.length).trim() : first;
const take = rawTake.charAt(0).toUpperCase() + rawTake.slice(1);
---

<div class={rule ? 'tldr ruled' : 'tldr'}>
  <p class="label">TL;DR</p>
  <p class="tldr-take">
    {tagged && <span class="tldr-tag">My read</span>}
    {take}
  </p>
  {
    !summary && rest.length > 0 && (
      <ul role="list">
        {rest.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    )
  }
</div>
