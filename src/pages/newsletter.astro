---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
---

<Base
  title="Newsletter"
  description="Sign up for Good Potatoes, written by David Hynes. One person, no sponsors, no affiliate links."
  current="newsletter"
>
  <header class="plain-head">
    <div class="wrap"><h1>Newsletter</h1></div>
  </header>
  <div class="wrap plain-body">
    <section class="band newsletter" aria-labelledby="news-h">
      <h2 class="label" id="news-h">Good Potatoes</h2>
      <Signup id="email-newsletter" />
    </section>
    <div class="md">
      <p>
        Good Potatoes is written by David Hynes. One person, no sponsors, no affiliate links. Your email address goes to
        Substack, which sends the newsletter. See <a href="/privacy/">Privacy</a>.
      </p>
    </div>
  </div>
</Base>
