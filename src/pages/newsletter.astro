---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import { site } from '../config/site';
import { getWriting } from '../lib/content';

// The "start with" link appears only once there is a piece to point at.
const [latest] = await getWriting();
// "Substack" becomes a link once the publication address is set in site.ts.
const substack = site.newsletter.publicationUrl;
---

<Base
  title="Newsletter"
  description="Good Potatoes by email, free: what hospitality vendors’ own contracts say about your data and fees, with an email to send back. Same pieces as this site."
  current="newsletter"
>
  <header class="plain-head">
    <div class="wrap"><h1>Newsletter</h1></div>
  </header>
  <div class="wrap plain-body">
    <section class="band newsletter" aria-labelledby="news-h">
      <h2 class="label" id="news-h">Good Potatoes</h2>
      <Signup id="email-newsletter" />
    </section>
    <div class="md indent">
      {
        substack ? (
          <p>
            Good Potatoes is free, on this site and on <a href={substack} rel="noopener">Substack</a>. Every piece goes to
            both, in full.
          </p>
        ) : (
          <p>Good Potatoes is free. Every piece is published here in full.</p>
        )
      }
      <h2>What each piece gives you</h2>
      <ul>
        <li><p>My read in one line, and the two facts behind it.</p></li>
        <li><p>The source’s own words, with the document, clause and date, so you can check them yourself.</p></li>
        <li><p>What the evidence does not show, said plainly.</p></li>
        <li><p>An email to the vendor, ready to paste.</p></li>
      </ul>
      {
        latest && (
          <p>
            Start with <a href={`/writing/${latest.id}/`}>{latest.data.title}</a>.
          </p>
        )
      }
      <p>
        Substack sends the emails and holds your address. <a href="/privacy/">Privacy</a> has the rest.
      </p>
    </div>
  </div>
</Base>
