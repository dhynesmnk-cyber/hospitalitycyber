---
import { render } from 'astro:content';
import Piece from '../../layouts/Piece.astro';
import Signup from '../../components/Signup.astro';
import ChapterList from '../../components/ChapterList.astro';
import { getChapters, getWriting, chapterNumber } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getWriting();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const background = (await getChapters()).filter((c) => entry.data.chapters.includes(chapterNumber(c.data.number)));
---

<Piece
  kind="writing"
  title={entry.data.title}
  description={entry.data.description}
  standfirst={entry.data.standfirst}
  noindex={entry.data.noindex || entry.data.draft}
  label="Writing"
  labelHref="/writing/"
  stampWord={entry.data.draft ? 'Draft' : 'Read'}
  stampDate={entry.data.pubDate}
  tocLabel="In this piece"
  headings={headings}
  sources={entry.data.sources}
  badge={entry.data.draft ? 'Not published' : undefined}
>
  <Content />

  <Fragment slot="after">
    {
      background.length > 0 && (
        <section class="band" aria-labelledby="bg-h">
          <h2 class="label" id="bg-h">Background chapters</h2>
          <div class="band-main">
            <p class="band-intro">From the Hospitality Tools Resource.</p>
            <ChapterList chapters={background} />
          </div>
        </section>
      )
    }
    <section class="band newsletter" aria-labelledby="news-h">
      <h2 class="label" id="news-h">Newsletter</h2>
      <Signup id="email-piece" />
    </section>
  </Fragment>
</Piece>
