---
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import Tldr from '../../components/Tldr.astro';
import { getWriting } from '../../lib/content';

const pieces = await getWriting();
const count = `${pieces.length} ${pieces.length === 1 ? 'piece' : 'pieces'} so far.`;
---

<Base
  title="Writing"
  description="What hospitality vendors’ contracts, price lists and statements say about your group. Each piece is dated and ends with an email to send back."
  current="writing"
>
  <header class="plain-head">
    <div class="wrap"><h1>Writing</h1></div>
  </header>
  <div class="wrap plain-body">
    {
      pieces.length > 0 && (
        <p class="band-intro indent">
          {count} Each takes one claim and checks it against the source’s own paperwork, from contracts and price lists
          to breach notices and the law. Each ends with an email you can send.
        </p>
      )
    }
    {
      pieces.length === 0 ? (
        <p class="empty indent">Nothing is published here yet.</p>
      ) : (
        <div class="piece-list">
          {pieces.map((p) => (
            <section class="band">
              <div class="piece-meta">
                <Stamp word={p.data.draft ? 'Draft' : 'Read'} date={p.data.pubDate} />
              </div>
              <article class="band-main lead-piece">
                <h2 class="lead-title">
                  <a href={`/writing/${p.id}/`}>{p.data.title}</a>
                </h2>
                <Tldr items={p.data.tldr} summary />
                <p class="more">
                  <a href={`/writing/${p.id}/`}>
                    Read the piece<span class="visually-hidden">: {p.data.title}</span>
                  </a>
                </p>
              </article>
            </section>
          ))}
        </div>
      )
    }
  </div>
</Base>
