---
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import { getWriting } from '../../lib/content';

const pieces = await getWriting();
---

<Base
  title="Writing"
  description="Pieces by David Hynes on what AI and software vendors say about a venue group's data, read from their own terms and dated."
  current="writing"
>
  <header class="plain-head">
    <div class="wrap"><h1>Writing</h1></div>
  </header>
  <div class="wrap plain-body">
    {
      pieces.length === 0 ? (
        <p class="empty">Nothing is published here yet.</p>
      ) : (
        pieces.map((p) => (
          <article class="band lead-piece">
            <h2 class="lead-title">
              <a href={`/writing/${p.id}/`}>{p.data.title}</a>
            </h2>
            <Stamp word={p.data.draft ? 'Draft' : 'Read'} date={p.data.pubDate} />
            <p class="excerpt">{p.data.description}</p>
          </article>
        ))
      )
    }
  </div>
</Base>
