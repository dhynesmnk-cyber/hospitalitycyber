---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import Stamp from '../components/Stamp.astro';
import Tldr from '../components/Tldr.astro';
import { getChapters, getWriting } from '../lib/content';

const writing = await getWriting();
const [latest, ...older] = writing;
// Under the lead piece, the next few headlines, so a reader has more than one way in.
const more = older.slice(0, 3);
const chapterCount = (await getChapters()).length;

// What the reader needs from an AI decision. David's wording, 15 November 2026, put in the
// second person ("you") at his request on 16 November 2026.
const needs = [
  'Payback you can put a number on, fast enough to defend to the board',
  'Certainty your group owns and can move the data the AI runs on',
  'Confidence your AI lead hire will deliver in the first 90 days',
  'Leverage in vendor negotiations, so you buy from knowledge rather than a demo',
  'A dated paper trail showing you made the decision carefully',
];
---

<Base
  title="Good Potatoes, by David Hynes"
  description="Judge AI like any other spend: return, risk, evidence. Info and articles on your AI ROI, from hospitality vendors’ own terms, quoted and dated."
>
  <section class="masthead">
    <div class="wrap">
      <h1>Judge AI like any other spend: return, risk, evidence.</h1>
      <p class="dek">Info and articles on your AI ROI.</p>
    </div>
  </section>

  <div class="wrap bands">
    <section class="band needs" aria-labelledby="needs-h">
      <h2 class="label" id="needs-h">What you need from AI spend</h2>
      <div class="band-main">
        <ul class="points needs-list" role="list">
          {needs.map((line) => <li><p>{line}</p></li>)}
        </ul>
      </div>
    </section>

    {
      latest && (
        <section class="band latest" aria-labelledby="latest-h">
          <h2 class="label" id="latest-h">Latest</h2>
          <article class="band-main lead-piece">
            <h3 class="lead-title">
              <a href={`/writing/${latest.id}/`}>{latest.data.title}</a>
            </h3>
            <Stamp word={latest.data.draft ? 'Draft' : 'Read'} date={latest.data.pubDate} />
            <Tldr items={latest.data.tldr} />
            <p class="more">
              <a href={`/writing/${latest.id}/`}>
                Read the piece<span class="visually-hidden">: {latest.data.title}</span>
              </a>
            </p>
            {more.length > 0 && (
              <div class="more-pieces">
                <h3 class="more-pieces-label">More pieces</h3>
                <ul class="more-pieces-list" role="list">
                  {more.map((p) => (
                    <li><a href={`/writing/${p.id}/`}>{p.data.title}</a></li>
                  ))}
                </ul>
                <p class="more"><a href="/writing/">All {writing.length} pieces</a></p>
              </div>
            )}
          </article>
        </section>
      )
    }

    <section class="band reference" aria-labelledby="ref-h">
      <h2 class="label" id="ref-h">Reference</h2>
      <div class="band-main">
        <h3 class="band-title"><a href="/chapters/">Hospitality Tools Resource</a></h3>
        <p class="band-text">
          {chapterCount > 0 ? `${chapterCount} chapters` : 'Chapters'} on the software and platforms behind Australian
          venues. Each one lists its sources and the day I read them.
        </p>
        <p class="more"><a href="/chapters/">Browse the chapters</a></p>
      </div>
    </section>

    <section class="band newsletter" aria-labelledby="news-h">
      <h2 class="label" id="news-h">Newsletter</h2>
      <Signup id="email-home" />
    </section>
  </div>
</Base>
