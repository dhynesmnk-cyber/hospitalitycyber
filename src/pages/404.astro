---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page does not exist." noindex>
  <header class="plain-head">
    <div class="wrap"><h1>Page not found</h1></div>
  </header>
  <div class="wrap plain-body">
    <div class="md indent">
      <p>
        That address does not lead anywhere. Try the <a href="/">home page</a>, the <a href="/writing/">writing</a> or the <a href="/chapters/">Hospitality Tools Resource</a>.
      </p>
    </div>
  </div>
</Base>
