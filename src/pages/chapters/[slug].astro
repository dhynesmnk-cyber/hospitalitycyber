---
import { render } from 'astro:content';
import Piece from '../../layouts/Piece.astro';
import ChapterList from '../../components/ChapterList.astro';
import Tldr from '../../components/Tldr.astro';
import { chapterNumber, getChapters, getWriting } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getChapters();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const readMinutes = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).filter(Boolean).length / 230));
const no = chapterNumber(entry.data.number);

const all = await getChapters();
const related = all.filter((c) => entry.data.related.includes(chapterNumber(c.data.number)));
const referredIn = (await getWriting()).filter((p) => p.data.chapters.includes(no));

// Previous and next among the chapters that are published (or visible in a draft view).
const at = all.findIndex((c) => c.id === entry.id);
const prev = at > 0 ? all[at - 1] : undefined;
const next = at >= 0 && at < all.length - 1 ? all[at + 1] : undefined;
---

<Piece
  kind="chapter"
  title={entry.data.title}
  description={entry.data.description}
  noindex={entry.data.noindex || entry.data.draft}
  label="Hospitality Tools Resource"
  labelHref="/chapters/"
  chapterNo={no}
  stampWord="As at"
  stampDate={entry.data.asOf}
  tocLabel="In this chapter"
  headings={headings}
  sources={entry.data.sources}
  readMinutes={readMinutes}
  badge={entry.data.status === 'background-verify' ? 'Background chapter' : undefined}
>
  <Content />

  <Fragment slot="after">
    {
      referredIn.length > 0 && (
        <section class="band" aria-labelledby="in-h">
          <h2 class="label" id="in-h">Pieces that go deeper</h2>
          <div class="band-main">
            {
              referredIn.map((p) => (
                <article class="lead-piece">
                  <h3 class="lead-title"><a href={`/writing/${p.id}/`}>{p.data.title}</a></h3>
                  <Tldr items={p.data.tldr} summary />
                </article>
              ))
            }
          </div>
        </section>
      )
    }
    {
      related.length > 0 && (
        <section class="band" aria-labelledby="rel-h">
          <h2 class="label" id="rel-h">Related chapters</h2>
          <div class="band-main"><ChapterList chapters={related} /></div>
        </section>
      )
    }
    {
      (prev || next) && (
        <nav class="pager" aria-label="Previous and next chapter">
          {
            prev ? (
              <a class="pager-link pager-prev" href={`/chapters/${prev.id}/`}>
                <span class="pager-dir">Previous chapter</span>
                <span class="pager-title"><span class="pager-no">{chapterNumber(prev.data.number)}</span> {prev.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a class="pager-link pager-next" href={`/chapters/${next.id}/`}>
                <span class="pager-dir">Next chapter</span>
                <span class="pager-title"><span class="pager-no">{chapterNumber(next.data.number)}</span> {next.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      )
    }
  </Fragment>
</Piece>
